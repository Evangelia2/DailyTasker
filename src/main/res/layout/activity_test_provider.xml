<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <Button
        android:id="@+id/btnAddTestData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Test Data"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnReadUpcoming"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Read Upcoming Task"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnUpdateTestData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Update Test Data"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnDeleteUpcoming"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delete Upcoming Task"/>

</LinearLayout>
